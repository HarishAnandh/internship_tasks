import java.util.*;
import java.time.*;
import java.time.format.*;
import java.util.regex.*;


class LimitReachedException extends Exception {
    LimitReachedException(String msg){
        super(msg);
    }
}
class Employee {
    int id;
    double salary;
    Employee(int id,double salary) throws LimitReachedException{
        this.id = id;
        if(salary < 5000){
        this.salary = salary;
        }
        else {
            throw new LimitReachedException("Limit croseed above 5000");
        }
    }
    void display(){
        System.out.println("id: "+id+"\nsalary: "+salary);
    }
}
class Manager extends Employee{
    int age;
   Manager(int id,double salary,int age) throws LimitReachedException{
       super(id,salary);
        this.age = age;
        System.out.println("Manager age: "+age);
    }
}
class Teacher extends Employee{
    int exp;
    Teacher(int id,double salary,int exp) throws LimitReachedException{
         super(id,salary);
        this.exp =exp;
       System.out.println("Teacher exp: "+exp);
    }
}
